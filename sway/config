# Mod1 is the Alt key
set $mod Mod1

# Font choice (Using FiraCode instead of JetBrains Mono)
font pango:UbuntuMono Nerd Font 18


#Specific to desktop
output HDMI-A-3 resolution 1920x1080@60Hz position 0 0
output DP-1 resolution 1920x1080@144Hz position 1920 0
workspace 1 output DP-1
workspace 10 output HDMI-A-3
#Specific to desktop end

# --- Native Sway-isms (Replacing X11 tools) ---

# Replace setxkbmap: Native keyboard configuration
input * {
    xkb_options caps:swapescape
}

# Replace nitrogen: Native background handling (using your Gruvbox background color)
output * bg #242724 solid_color

# Replace xss-lock: Native idle management and screen locking
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000'

# Replace redshift/xrandr: Native Wayland nightlight (Coordinates for Newark)
exec wlsunset -l 39.6 -L -75.7

# --- Autostart & Plumbing ---

exec dex --autostart --environment sway
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec nm-applet
exec blueman-applet

# --- Media & Hardware Keys ---

# Volume control
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brightness control (Requires brightnessctl package)
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- Core Shortcuts ---

# Floating modifier
floating_modifier $mod

# Terminal
bindsym $mod+Return exec foot

# Kill focused window
bindsym $mod+Shift+q kill

# Replace Rofi: Native Wayland launcher
bindsym $mod+space exec wofi --show drun

# Replace Flameshot: Native Wayland screenshots (Requires grim and slurp)
# This lets you select an area and copies it directly to your clipboard
bindsym Print exec grim -g "$(slurp)" - | wl-copy

# Custom app shortcuts
bindsym $mod+b exec firefox

# --- Window Focus & Movement ---

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# --- Layouts & Splits ---

bindsym $mod+semicolon split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+p floating toggle
bindsym $mod+p focus mode_toggle
bindsym $mod+a focus parent

# --- Workspaces ---

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- System Management ---

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r exec swaymsg reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

# --- Resize Mode ---

mode "resize" {
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"


# --- Sleep ---

bindsym $mod+BackSpace exec systemctl suspend

# --- Appearance & Borders ---

default_border normal
default_floating_border normal

for_window [app_id="foot"] border pixel 1
for_window [class="Alacritty"] border pixel 1
for_window [app_id="firefox_firefox"] border pixel 1

# Gruvbox "Pastel Forest" Palette
# class                 border  backgr. text    indicator child_border
client.focused          #95bbad #95bbad #242724 #95bbad   #95bbad
client.focused_inactive #3a3f3a #3a3f3a #bdae93 #3a3f3a   #3a3f3a
client.unfocused        #242724 #242724 #7c6f64 #242724   #242724
client.urgent           #ce999a #ce999a #242724 #ce999a   #ce999a
client.placeholder      #242724 #242724 #ffffff #242724   #242724
client.background       #242724

# --- Status Bar ---

# Replace Polybar: Native Waybar integration

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

bar {
    swaybar_command waybar
}
